<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Arch Nemesis — CISC 322/326</title>

  <style>
    :root {
      --bg: #f3f3f1;
      --card: #ffffff;
      --text: #171717;
      --muted: #747474;
      --line: #ddddda;
      --accent: #2457ff;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: Arial, Helvetica, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .page {
      width: min(1120px, calc(100% - 32px));
      margin: 0 auto;
    }


    /* NAVIGATION */

    nav {
      height: 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--line);
    }

    .brand {
      font-weight: 700;
      font-size: 15px;
    }

    .nav-links {
      display: flex;
      gap: 26px;
      font-size: 13px;
      color: var(--muted);
    }

    .nav-links a:hover {
      color: var(--text);
    }


    /* HERO */

    .hero {
      padding: 90px 0 80px;
    }

    .eyebrow {
      font-size: 12px;
      color: var(--accent);
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 24px;
    }

    h1 {
      max-width: 850px;
      margin: 0;
      font-size: clamp(54px, 9vw, 110px);
      line-height: 0.92;
      letter-spacing: -0.065em;
      font-weight: 700;
    }

    .hero-bottom {
      margin-top: 55px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 30px;
    }

    .intro {
      max-width: 510px;
      margin: 0;
      color: var(--muted);
      font-size: 18px;
      line-height: 1.55;
    }

    .scroll-link {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      font-size: 14px;
      font-weight: 600;
    }

    .circle {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--text);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
    }


    /* SECTION */

    .section {
      padding: 80px 0;
      border-top: 1px solid var(--line);
    }

    .section-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 35px;
    }

    .section-number {
      color: var(--accent);
      font-size: 12px;
      font-weight: 700;
    }

    h2 {
      margin: 0;
      font-size: clamp(34px, 5vw, 58px);
      letter-spacing: -0.045em;
      line-height: 1;
    }


    /* TEAM GRID */

    .team-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .person {
      background: var(--card);
      min-height: 190px;
      border-radius: 14px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }

    .person:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.07);
    }

    .role {
      color: var(--muted);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }

    .person-bottom {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 15px;
    }

    .person-name {
      font-size: 22px;
      font-weight: 600;
      letter-spacing: -0.025em;
    }

    .arrow {
      color: var(--accent);
      font-size: 22px;
    }


    /* PROJECT DOCUMENTS */

    .documents {
      display: grid;
      gap: 10px;
    }

    .document {
      background: var(--card);
      border-radius: 14px;
      min-height: 100px;
      padding: 22px 25px;
      display: grid;
      grid-template-columns: 60px 1fr auto;
      align-items: center;
      transition:
        background 0.2s ease,
        color 0.2s ease;
    }

    .document:hover {
      background: var(--text);
      color: white;
    }

    .doc-number {
      color: var(--muted);
      font-size: 12px;
    }

    .doc-title {
      font-size: 24px;
      font-weight: 600;
      letter-spacing: -0.025em;
    }

    .document .arrow {
      font-size: 26px;
    }


    /* PRESENTATION */

    .presentation-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .presentation-card {
      background: var(--card);
      border-radius: 14px;
      min-height: 270px;
      padding: 26px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.2s ease;
    }

    .presentation-card:hover {
      transform: translateY(-4px);
    }

    .card-label {
      color: var(--muted);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .card-bottom {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
    }

    .card-title {
      font-size: clamp(36px, 5vw, 60px);
      font-weight: 600;
      letter-spacing: -0.05em;
    }


    /* FEATURE CARD */

    .feature {
      background: var(--accent);
      color: white;
      border-radius: 18px;
      padding: 45px;
      margin: 20px 0 80px;
      min-height: 300px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .feature-small {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      opacity: 0.7;
    }

    .feature-title {
      max-width: 700px;
      font-size: clamp(38px, 6vw, 72px);
      line-height: 0.98;
      letter-spacing: -0.05em;
      font-weight: 600;
    }


    /* FOOTER */

    footer {
      border-top: 1px solid var(--line);
      padding: 30px 0 45px;
      display: flex;
      justify-content: space-between;
      color: var(--muted);
      font-size: 12px;
    }


    /* MOBILE */

    @media (max-width: 700px) {

      .page {
        width: calc(100% - 28px);
      }

      nav {
        height: 62px;
      }

      .nav-links {
        gap: 14px;
        font-size: 12px;
      }

      .hero {
        padding: 65px 0 60px;
      }

      h1 {
        font-size: clamp(55px, 18vw, 80px);
      }

      .hero-bottom {
        margin-top: 40px;
        flex-direction: column;
        align-items: flex-start;
      }

      .intro {
        font-size: 16px;
      }

      .section {
        padding: 60px 0;
      }

      .section-top {
        margin-bottom: 28px;
      }

      .team-grid {
        grid-template-columns: 1fr;
      }

      .person {
        min-height: 135px;
      }

      .document {
        min-height: 88px;
        grid-template-columns: 42px 1fr auto;
        padding: 18px;
      }

      .doc-title {
        font-size: 19px;
      }

      .presentation-grid {
        grid-template-columns: 1fr;
      }

      .presentation-card {
        min-height: 190px;
      }

      .feature {
        min-height: 250px;
        padding: 28px;
        margin-bottom: 60px;
      }

      footer {
        gap: 15px;
        flex-direction: column;
      }
    }

  </style>
</head>


